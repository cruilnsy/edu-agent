# Copy to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent_en
DB_USER=eduagent
DB_PASSWORD=change-me

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19531
MILVUS_COLLECTION=knowledge_domain_en

# MinIO root credentials, used only inside the Docker network
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-at-least-8-chars

# LLM
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash

# Local models, relative to the project root
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-v2-m3
CLASSIFIER_MODEL_PATH=./models/classifier/all-MiniLM-L6-v2
BGE_M3_MODEL_PATH=./models/embedding/bge-m3

# Auth: generate the key with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Web search
TAVILY_API_KEY=your-tavily-api-key

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8010
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# Dev account passwords for scripts/seed_data.py (at least 12 characters each)
SEED_ADMIN_PASSWORD=change-me-admin
SEED_TEACHER_PASSWORD=change-me-teacher
SEED_STUDENT_PASSWORD=change-me-student
